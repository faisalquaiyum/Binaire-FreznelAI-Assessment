{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/models",
        "function": "models"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
